# 推荐：密钥放在本地文件（如仓库外或已 gitignore 的 LLM_API信息.txt），避免 export 进 shell 历史
export CANGJIE_LLM_API_FILE="/absolute/path/to/LLM_API信息.txt"

export OPENAI_BASE_URL="https://api.modelarts-maas.com/openai/v1"
export OPENAI_MODEL="deepseek-v3.2"
# 若已设置 CANGJIE_LLM_API_FILE，load_env.sh 会优先从文件读取并忽略环境中错误的占位 OPENAI_API_KEY
export OPENAI_API_KEY="<可选：也可直接填 key，不要入库>"
export LLM_CONCURRENCY=64
export LLM_CACHE_DIR=/data/llm-cache-persistent
export GRAPHIFY_CACHE_DIR=/data/graphify-cache-persistent
